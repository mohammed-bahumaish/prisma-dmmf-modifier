{
  "name": "@mohammed-bahumaish/prisma-dmmf-modifier",
  "version": "1.0.0",
  "description": "A TypeScript library to programmatically modify Prisma's DMMF (Datamodel Meta Format)",
  "license": "MIT",
  "author": "Mohammed Bahumaish <mohammed.bahumaish@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohammed-bahumaish/prisma-dmmf-modifier.git"
  },
  "keywords": [
    "prisma",
    "dmmf",
    "schema",
    "modifier",
    "datamodel"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf .turbo node_modules dist",
    "dev": "tsup --watch",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@prisma/engine-core": "^4.10.1",
    "@prisma/generator-helper": "^4.10.1",
    "@prisma/internals": "^4.10.1",
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2",
    "strip-ansi": "^7.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.4.0",
    "jest": "^29.5.0",
    "prisma": "^3.15.2",
    "rimraf": "^3.0.2",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "tsx": "^3.12.3",
    "typescript": "^4.9.5",
    "tsup": "^6.6.3",
    "@types/node": "^18.15.10"
  }
}
